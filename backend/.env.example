# Copy to .env and adjust. Never commit a real secret.
# sqlite for a zero-setup run, or postgresql+psycopg://user:pass@db:5432/gemini
DATABASE_URL=sqlite:///./gemini-clone.db
# Signing key for access tokens. Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_SECRET=change-me-in-production
TOKEN_TTL_SECONDS=604800
# Origins allowed to call the API (the cloned front end's dev server)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
